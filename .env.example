# Copy to .env.local to run on your computer. On Vercel, add the same names under
# Project > Settings > Environment Variables. Never share these values or commit them.

# --- Clerk (sign-up, log in, Google login) ---
# Clerk > Configure > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (database: credits, plans, saved searches and leads) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Needed for the Masar CLI (sign-in, saving its leads) and for giving customers their own Claude key.
SUPABASE_SERVICE_ROLE_KEY=

# --- PostHog (analytics: visits, sign-ups, searches) ---
# PostHog > Settings > Project > Project API key (starts with phc_). Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
# The PostHog Cloud you signed up on: us or eu
NEXT_PUBLIC_POSTHOG_REGION=us

# --- Claude (the research engine) ---
# Your main key from console.anthropic.com. Used for everyone without their own key.
ANTHROPIC_API_KEY=

# --- Google Maps (recommended: better shop lists with phones and ratings) ---
# Google Cloud > APIs & Services: enable "Places API (New)". Used by the Google & web collector.
GOOGLE_MAPS_API_KEY=
# Also search OpenStreetMap (free open data) on the website. The CLI always does.
MASAR_USE_OSM=false

# --- Official social APIs (optional; each collector stays off without its credentials) ---
# See docs/agents.md for what each one needs and what it can and cannot do.
META_GRAPH_VERSION=v26.0
# Instagram Business Discovery: a token of an Instagram professional account linked to your Meta app,
# with instagram_basic, instagram_manage_insights and pages_read_engagement, and that account's id.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Facebook Pages search: an app access token from a Meta app with the Page Public Metadata Access feature.
FACEBOOK_APP_ACCESS_TOKEN=
# LinkedIn organization lookup: a 3-legged token from an app approved for the Community Management API.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202510

# --- Your details, shown on the site ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Let users paste their own keys in Settings (leave false)
ALLOW_USER_KEYS=false

# Price shown on the home page (optional)
NEXT_PUBLIC_PRICE_EN=100 JOD
NEXT_PUBLIC_PRICE_AR=100 دينار أردني

# Masar CLI: make CLI leads free for everyone (Premium members never pay for CLI leads anyway)
CLI_FREE_LEADS=false
