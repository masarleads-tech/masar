# Copy to .env.local to run on your computer. On Vercel, add the same names under
# Project > Settings > Environment Variables. Never share these values or commit them.

# --- Clerk (sign-up, log in, Google login) ---
# Clerk > Configure > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (database: credits, plans, saved searches and leads) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Needed for the Masar CLI (sign-in, saving its leads) and for giving customers their own Claude key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (the research engine) ---
# Your main key from console.anthropic.com. Used for everyone without their own key.
ANTHROPIC_API_KEY=

# --- Google Maps (recommended: better shop lists with phones and ratings) ---
GOOGLE_MAPS_API_KEY=

# --- Your details, shown on the site ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Let users paste their own keys in Settings (leave false)
ALLOW_USER_KEYS=false

# Price shown on the home page (optional)
NEXT_PUBLIC_PRICE_EN=100 JOD
NEXT_PUBLIC_PRICE_AR=100 دينار أردني

# Masar CLI: make CLI leads free for everyone (Premium members never pay for CLI leads anyway)
CLI_FREE_LEADS=false
