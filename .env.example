# Copy to .env.local to run on your computer. On Vercel, add the same names under
# Project > Settings > Environment Variables. Never share these values or commit them.

# --- Clerk (sign-up, log in, Google login) ---
# Clerk > Configure > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (database: credits, plans, saved searches and leads) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Needed for the Masar CLI (sign-in, saving its leads) and for giving customers their own Claude key.
SUPABASE_SERVICE_ROLE_KEY=

# --- PostHog (analytics: visits, sign-ups, searches) ---
# PostHog > Settings > Project > Project API key (starts with phc_). Leave empty to turn analytics off.
# (NEXT_PUBLIC_POSTHOG_KEY and NEXT_PUBLIC_POSTHOG_REGION also work.)
POSTHOG_KEY=
# The PostHog Cloud you signed up on: us or eu
POSTHOG_REGION=us

# --- Sentry (error tracking: tells you when something breaks on the site) ---
# Sentry > Settings > Projects > (your project) > Client Keys (DSN). Leave empty to turn it off.
SENTRY_DSN=
# Optional, for readable error locations: your organization and project slugs from the Sentry URL,
# and an organization auth token (Settings > Auth Tokens, starts with sntrys_). Secret: only in Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Upstash Redis (rate limits on searches and CLI sign-in, plus a 12-hour cache of public web pages) ---
# Upstash > your database > REST API: the URL (https://...) and the token. Leave empty to turn it off.
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; those work too.
# The token is secret: only in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pinecone (lead memory: leads that look like ones a member marked Won or Meeting move up the list) ---
# Vercel > Integrations > Pinecone sets both of these (pick the multilingual-e5-large model there). Leave empty to turn it off.
# Or only the key from Pinecone > API keys: Masar then creates the index (masar-leads, AWS us-east-1) by itself.
# The key is secret: only in Vercel.
PINECONE_API_KEY=
PINECONE_HOSTNAME=
# Optional, without PINECONE_HOSTNAME: another index name
PINECONE_INDEX=

# --- PayPal (members pay for Basic or Premium on /billing, with a PayPal account or a card) ---
# PayPal Developer > Apps & Credentials > your REST app: Client ID and Secret. Leave empty to turn checkout off.
# Start with the Sandbox app's keys; switch to the Live app's keys and PAYPAL_ENV=live when ready.
# The secret is secret: only in Vercel.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (test money) or live
PAYPAL_ENV=sandbox
# Webhooks (recommended): in the same app add https://<your site>/api/billing/paypal/webhook with the events
# Checkout order approved, Payment capture completed, denied, refunded and reversed, then paste the webhook's ID here.
PAYPAL_WEBHOOK_ID=
# Prices per 30-day month. PayPal can't charge in SAR or JOD, so prices are in USD (or EUR, GBP…).
PAYPAL_CURRENCY=USD
PAYPAL_PRICE_BASIC=141
PAYPAL_PRICE_PREMIUM=199

# --- Claude (the research engine) ---
# Your main key from console.anthropic.com. Used for everyone without their own key.
ANTHROPIC_API_KEY=

# --- Google Maps (recommended: better shop lists with phones and ratings) ---
# Google Cloud > APIs & Services: enable "Places API (New)". Used by the Google & web collector.
GOOGLE_MAPS_API_KEY=
# Also search OpenStreetMap (free open data) on the website. The CLI always does.
MASAR_USE_OSM=false

# --- Official social APIs (optional; each collector stays off without its credentials) ---
# See docs/agents.md for what each one needs and what it can and cannot do.
META_GRAPH_VERSION=v26.0
# Instagram Business Discovery: a token of an Instagram professional account linked to your Meta app,
# with instagram_basic, instagram_manage_insights and pages_read_engagement, and that account's id.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Facebook Pages search: an app access token from a Meta app with the Page Public Metadata Access feature.
FACEBOOK_APP_ACCESS_TOKEN=
# LinkedIn organization lookup: a 3-legged token from an app approved for the Community Management API.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202510

# --- Your details, shown on the site ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Let users paste their own keys in Settings (leave false)
ALLOW_USER_KEYS=false

# Price shown on the home page (optional)
NEXT_PUBLIC_PRICE_EN=100 JOD
NEXT_PUBLIC_PRICE_AR=100 دينار أردني

# Masar CLI: make CLI leads free for everyone (Premium members never pay for CLI leads anyway)
CLI_FREE_LEADS=false
